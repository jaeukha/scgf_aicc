# 예시/placeholder 값만. 실제 비밀값은 커밋하지 말 것 (.env는 .gitignore)
APP_ENV=local
BACKEND_PORT=8000

# ---- 모델 Provider ----
# mock: 모델 없이 전체 흐름 시연 / local|demo: model_server.py(/internal/*) HTTP 호출
PROVIDER_MODE=mock
# Windows에서는 localhost 대신 127.0.0.1 사용(localhost는 IPv6 시도로 요청마다 ~2초 지연)
# docker compose 백엔드에서 호스트의 모델 서버를 부를 때: http://host.docker.internal:8101 (+ model_server --host 0.0.0.0)
ASR_BASE_URL=http://127.0.0.1:8101
ASR_TIMEOUT_SECONDS=30
ASR_FILE_TIMEOUT_SECONDS=900
DECIDER_BASE_URL=http://127.0.0.1:8101
DECIDER_TIMEOUT_SECONDS=30

# Coach: off | mock | api(OpenAI 호환 /chat/completions) | internal(model_server --coach)
COACH_MODE=mock
COACH_BASE_URL=http://127.0.0.1:8101
COACH_MODEL_NAME=Qwen/Qwen3.5-2B
COACH_TIMEOUT_SECONDS=45
# COACH_API_KEY=            # api 모드에서 필요 시. 로그/DB에 저장되지 않음

# ---- DB ----
# docker compose는 POSTGRES_* 로 DATABASE_URL을 자동 구성. 로컬 단독(미지정): sqlite:///./data/aicc.db
# DATABASE_URL=postgresql+psycopg://aicc:change-me@127.0.0.1:5432/aicc
POSTGRES_DB=aicc
POSTGRES_USER=aicc
POSTGRES_PASSWORD=change-me

# ---- Twenty CRM PoC (AICC → Twenty 단방향) ----
TWENTY_ENABLED=false
TWENTY_BASE_URL=http://127.0.0.1:3000
TWENTY_API_KEY=
TWENTY_TIMEOUT_SECONDS=15

# ---- 기타 ----
# ---- 사내 지식베이스 RAG ----
# local: data/knowledge/*.json 키워드 검색(샘플) / qdrant: Qdrant + EmbeddingGemma 2 의미 검색
KNOWLEDGE_MODE=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=aicc_kb
EMBED_BASE_URL=http://127.0.0.1:8104
EMBED_DIM=768
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.60
KNOWLEDGE_MAX_GAP=0.06
KNOWLEDGE_PATH=./data/knowledge
ROUTING_CONFIG_PATH=./config/routing.json
ROUTING_WINDOW=30
AUDIO_MAX_BYTES=262144000
AUDIO_EXTENSIONS=.wav,.mp3,.flac,.ogg
MOCK_DELAY_SECONDS=0.6
DEGRADED_ERROR_RATE=0.2
UNAVAILABLE_CONSECUTIVE_FAILURES=3
CORS_ORIGINS=
